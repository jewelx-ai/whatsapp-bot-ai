# Copy to .env.local and fill in real values. Never commit .env.local.
# .env.local is already gitignored; only this template file is tracked.

# ---------------------------------------------------------------------------
# Core / Next.js
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public base URL of this deployment. Read server-side only (src/lib/ai.ts,
# used as the OpenRouter HTTP-Referer header) despite the NEXT_PUBLIC_ prefix;
# it does not need to be passed as a Docker build arg.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (Postgres, Auth, RLS, Realtime, pgvector)
# ---------------------------------------------------------------------------
# Safe to expose to the browser; baked in at Docker build time as build args.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# ---------------------------------------------------------------------------
# Shared secret you choose; must match the value entered in the Meta app's
# webhook verification (GET /api/webhook, hub.verify_token).
WHATSAPP_VERIFY_TOKEN=
# Meta app secret used to verify the X-Hub-Signature-256 header on every
# inbound webhook POST (HMAC-SHA256, fails closed if unset).
WHATSAPP_APP_SECRET=
# 32-byte key (hex/base64/utf8) used to AES-256-GCM encrypt tenant WhatsApp
# access tokens at rest. Must stay identical across all running instances.
# See docs/17-token-encryption.md.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# Dev-only escape hatch to skip webhook signature verification. Never set
# this in production — the webhook handler fails closed without it.
ALLOW_UNSIGNED_WEBHOOKS=false

# Note: individual tenants' WhatsApp Phone Number ID and access token are
# configured per-workspace in the dashboard (/settings), not here.

# ---------------------------------------------------------------------------
# AI providers (choose one via AI_PROVIDER; GLM is the default/primary)
# ---------------------------------------------------------------------------
AI_PROVIDER=glm

# GLM (Z.ai)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL=glm-4.7-flashx

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Knowledge base / RAG
# ---------------------------------------------------------------------------
# Optional: enables pgvector semantic search; falls back to Postgres FTS if unset.
VOYAGE_API_KEY=
# Comma-separated hostname allow-list for URL knowledge-base ingestion
# (SSRF guard for POST /api/kb/url).
KB_INGEST_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Cron / platform admin
# ---------------------------------------------------------------------------
# Bearer token required to call POST /api/worker/broadcasts (the broadcast
# batch worker). Triggered by Vercel Cron on Vercel, or a host cron/systemd
# timer in a self-hosted Docker deployment — see docs/DEPLOYMENT.md.
CRON_SECRET=
# Email of the single Supabase-authenticated account allowed into the
# platform operator portal at /admin.
PLATFORM_SUPER_ADMIN_EMAIL=
